<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="App.Controllers.ClientController"
      spacing="10"
      style="-fx-padding:20;">

    <Label text="Cadastro de Clientes"
           style="-fx-font-size:18; -fx-font-weight:bold;"/>

    <GridPane hgap="10" vgap="10">

        <Label text="Nome:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNome" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEmail" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    </GridPane>

    <HBox spacing="10">
        <Button text="Salvar" onAction="#salvar"/>
        <Button text="Limpar" onAction="#limpar"/>
    </HBox>

    <TableView fx:id="tableClientes" prefHeight="250">
        <columns>
            <TableColumn text="ID" fx:id="colId"/>
            <TableColumn text="Nome" fx:id="colNome"/>
            <TableColumn text="Email" fx:id="colEmail"/>
        </columns>
    </TableView>

</VBox>

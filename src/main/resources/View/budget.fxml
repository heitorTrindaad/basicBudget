<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.*?>

<VBox spacing="10" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="App.Controllers.BudgetController">

    <Label text="Cliente:" style="-fx-font-weight: bold;"/>
    <ComboBox fx:id="cbClientes" prefWidth="300" promptText="Selecione o Cliente"/>

    <Separator/>

    <Label text="Estrutura do Orçamento:" style="-fx-font-weight: bold;"/>
    <HBox spacing="10">
        <TextField fx:id="txtNomeGrupo" promptText="Nome do Subgrupo (ex: Quadro 01)" HBox.hgrow="ALWAYS"/>
        <Button text="Criar Novo Grupo" onAction="#criarNovoGrupo"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;"/>
    </HBox>

    <Separator/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <ComboBox fx:id="cbProduto" promptText="Selecione o Produto" prefWidth="200"/>
        <TextField fx:id="txtQtd" promptText="Qtd" prefWidth="80"/>
        <Button text="Adicionar ao Grupo Selecionado" onAction="#add"
                style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-cursor: hand;"/>
    </HBox>

    <TreeView fx:id="treeOrcamento" prefHeight="350" VBox.vgrow="ALWAYS"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Editar Item" onAction="#editarSelecionado"
                style="-fx-background-color: #f1c40f; -fx-cursor: hand;"/>
        <Button text="Remover Selecionado" onAction="#removerSelecionado"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;"/>

        <Region HBox.hgrow="ALWAYS" />

        <Label fx:id="lblTotal" text="Total Geral: R$ 0.00"
               style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #2c3e50;"/>
    </HBox>

    <Separator/>

    <Button text="FINALIZAR E SALVAR ORÇAMENTO" onAction="#salvar" maxWidth="Infinity" prefHeight="40"
            style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;"/>

</VBox>
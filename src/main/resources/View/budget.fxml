<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="App.Controllers.BudgetController">

    <Label text="Cliente:"/>

    <ComboBox fx:id="cbClientes"
              prefWidth="250"/>

    <ComboBox fx:id="cbProduto" promptText="Produto"/>
    <TextField fx:id="txtQtd" promptText="Quantidade"/>

    <Button text="Adicionar" onAction="#add"/>

    <ListView fx:id="lista"/>

    <Label fx:id="lblTotal"/>

    <Button text="Salvar Orçamento" onAction="#salvar"/>
</VBox>

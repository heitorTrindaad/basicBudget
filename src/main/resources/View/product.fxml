<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="App.Controllers.ProductController"
      spacing="10" style="-fx-padding:20;">

    <TextField fx:id="txtNome" promptText="Nome do produto"/>
    <TextField fx:id="txtPreco" promptText="Preço"/>

    <Button text="Salvar" onAction="#salvar"/>

    <ListView fx:id="lista"/>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.HistoryController"
      spacing="10"
      style="-fx-padding:15;">

    <Label text="Histórico de Orçamentos"
           style="-fx-font-size:18px; -fx-font-weight:bold;" />

    <TableView fx:id="tblHistorico"
               VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="colData" text="Data"/>
            <TableColumn fx:id="colCliente" text="Cliente"/>
            <TableColumn fx:id="colStatus" text="Status"/>
        </columns>

    </TableView>

    <HBox spacing="10">

        <Button text="Editar"
                onAction="#editarOrcamento"/>
    </HBox>

</VBox>